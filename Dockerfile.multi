# Dockerfile for uart_sms_forwarder-multi
# 多设备版本 - 简化构建

FROM golang:1.25-alpine AS builder
WORKDIR /build
COPY . .
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -ldflags="-s -w" -o uart_sms_forwarder ./cmd/serv

FROM alpine:latest
RUN apk add --no-cache ca-certificates tzdata || true
WORKDIR /app
COPY --from=builder /build/uart_sms_forwarder .
COPY --from=builder /build/config.example.yaml ./config.example.yaml
RUN mkdir -p /app/data /app/logs
RUN chmod +x ./uart_sms_forwarder
HEALTHCHECK --interval=30s --timeout=3s CMD wget -qO- http://localhost:8080/health || exit 1
CMD ["./uart_sms_forwarder"]
